# Ambiente: development | production
NODE_ENV=development
PORT=3000
HOST=http://localhost:3000

# Base de datos
MONGO_URI=mongodb://127.0.0.1:27017/ecotransporte

# Sesiones y JWT
SESSION_SECRET=super_secreto_ecotransporte_2026
JWT_SECRET=jwt_secreto_ecotransporte_2026

# SendGrid (Produccion)
SENDGRID_API_KEY=SG.tu_api_key_de_sendgrid_aqui
MAIL_FROM=no-reply@ecotransporte.com

# Ethereal (Desarrollo local - opcional, si se deja vacio crea cuenta de prueba automatica)
ETHEREAL_USER=
ETHEREAL_PASS=

# OAuth Google & Facebook
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
FACEBOOK_APP_ID=tu_facebook_app_id
FACEBOOK_APP_SECRET=tu_facebook_app_secret

# New Relic (APM)
NEW_RELIC_APP_NAME=ecotransporte-prod
NEW_RELIC_LICENSE_KEY=tu_new_relic_license_key
NEW_RELIC_NO_CONFIG_FILE=true
