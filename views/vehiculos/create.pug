extends ../layout

block content
  h2 Agregar Vehiculo
  form(action="/vehiculos/create", method="post")
    .mb-3
      label.form-label(for="code") Codigo
      input#code.form-control(type="number", name="code", required)
    .mb-3
      label.form-label(for="color") Color
      input#color.form-control(type="text", name="color", required)
    .mb-3
      label.form-label(for="modelo") Modelo
      input#modelo.form-control(type="text", name="modelo", required)
    .mb-3
      label.form-label(for="lat") Latitud
      input#lat.form-control(type="text", name="lat", value="14.0818", required)
    .mb-3
      label.form-label(for="lng") Longitud
      input#lng.form-control(type="text", name="lng", value="-87.2068", required)
    button.btn.btn-primary(type="submit") Guardar
