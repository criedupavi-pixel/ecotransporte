extends ../layout

block content
  h2 Editar Vehiculo
  form(action="/vehiculos/" + vehiculo._id + "/update", method="post")
    .mb-3
      label.form-label(for="code") Codigo
      input#code.form-control(type="number", name="code", value=vehiculo.code, required)
    .mb-3
      label.form-label(for="color") Color
      input#color.form-control(type="text", name="color", value=vehiculo.color, required)
    .mb-3
      label.form-label(for="modelo") Modelo
      input#modelo.form-control(type="text", name="modelo", value=vehiculo.modelo, required)
    .mb-3
      label.form-label(for="lat") Latitud
      input#lat.form-control(type="text", name="lat", value=vehiculo.ubicacion[0], required)
    .mb-3
      label.form-label(for="lng") Longitud
      input#lng.form-control(type="text", name="lng", value=vehiculo.ubicacion[1], required)
    button.btn.btn-primary(type="submit") Actualizar
