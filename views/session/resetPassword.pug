extends ../layout

block content
  .row.justify-content-center
    .col-md-5
      .card
        .card-body
          h3 Nuevo Password
          form(action="/resetPassword", method="post")
            input(type="hidden", name="email", value=usuario.email)
            .mb-3
              label.form-label(for="password") Nuevo Password
              input#password.form-control(type="password", name="password", required)
            .mb-3
              label.form-label(for="confirm_password") Confirmar Password
              input#confirm_password.form-control(type="password", name="confirm_password", required)
            button.btn.btn-success.w-100(type="submit") Guardar Password
