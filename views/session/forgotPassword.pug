extends ../layout

block content
  .row.justify-content-center
    .col-md-5
      .card
        .card-body
          h3 Recuperar Password
          if info && info.message
            .alert.alert-warning= info.message
          form(action="/forgotPassword", method="post")
            .mb-3
              label.form-label(for="email") Ingresa tu email
              input#email.form-control(type="email", name="email", required)
            button.btn.btn-primary.w-100(type="submit") Enviar enlace
