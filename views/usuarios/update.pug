extends ../layout

block content
  h2 Actualizar Usuario
  form(action="/usuarios/" + usuario._id + "/update", method="post")
    .mb-3
      label.form-label(for="nombre") Nombre
      input#nombre.form-control(type="text", name="nombre", value=usuario.nombre, required)
    button.btn.btn-primary(type="submit") Actualizar
