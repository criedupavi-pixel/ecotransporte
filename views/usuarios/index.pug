extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h2 Usuarios Registrados
    a.btn.btn-success(href="/usuarios/create") Nuevo Usuario
  table.table.table-striped
    thead
      tr
        th ID
        th Nombre
        th Email
        th Verificado
        th Proveedor OAuth
        th Acciones
    tbody
      each usuario in usuarios
        tr
          td= usuario._id
          td= usuario.nombre
          td= usuario.email
          td= usuario.verificado ? 'Si' : 'No'
          td= usuario.googleId ? 'Google' : (usuario.facebookId ? 'Facebook' : 'Local')
          td
            a.btn.btn-sm.btn-primary.me-2(href="/usuarios/" + usuario._id + "/update") Editar
            form.d-inline(action="/usuarios/" + usuario._id + "/delete", method="post")
              input(type="hidden", name="id", value=usuario._id)
              button.btn.btn-sm.btn-danger(type="submit") Eliminar
