{
  "info": {
    "name": "EcoTransporte - Produccion & Facebook Token",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Validar Token de Facebook (POST /api/auth/facebook_token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"access_token\": \"PEGA_AQUI_EL_ACCESS_TOKEN_DE_FACEBOOK_DEVELOPERS\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/facebook_token",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "facebook_token"]
        }
      }
    },
    {
      "name": "2. Crear Usuario API (Envia Email SendGrid / Ethereal)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Cristobal Pavon\",\n  \"email\": \"tu_correo_real@gmail.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/usuarios/create",
          "host": ["{{base_url}}"],
          "path": ["api", "usuarios", "create"]
        }
      }
    },
    {
      "name": "3. Autenticar Usuario Local (Obtener JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"tu_correo_real@gmail.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/authenticate",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "authenticate"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ]
}
